RewriteEngine On

# Redirection HTTPS (règle existante)
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Redirection des paramètres de langue vers la version canonique
RewriteCond %{QUERY_STRING} ^lang=(en|de|fr|it)$ [NC]
RewriteRule ^$ /? [R=301,L]

# Redirection des autres paramètres de requête vers la version canonique
RewriteCond %{QUERY_STRING} . [NC]
RewriteCond %{REQUEST_URI} ^/$ [NC]
RewriteRule ^$ /? [R=301,L]

# Bloquer l'accès aux fichiers et dossiers cachés (.env, .git, .claude…), sauf .well-known
RedirectMatch 404 "/\.(?!well-known/)"

# En-têtes de sécurité
# CSP : le hash autorise uniquement le handler onload du chargement asynchrone Google Fonts
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-hashes' 'sha256-1jAmyYXcRq6zFldLe/GCgIDJBiOONdXjTLgEFMDnDSM='; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' https://img.icons8.com; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests"
  Header always set X-Frame-Options "DENY"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"
</IfModule>

# Cache-Control for static assets
<IfModule mod_expires.c>
  ExpiresActive On
  # Images — 1 year
  ExpiresByType image/jpeg             "access plus 1 year"
  ExpiresByType image/png              "access plus 1 year"
  ExpiresByType image/webp             "access plus 1 year"
  ExpiresByType image/avif             "access plus 1 year"
  ExpiresByType image/svg+xml          "access plus 1 year"
  ExpiresByType image/gif              "access plus 1 year"
  ExpiresByType image/x-icon           "access plus 1 year"
  # Fonts — 1 year
  ExpiresByType font/woff              "access plus 1 year"
  ExpiresByType font/woff2             "access plus 1 year"
  ExpiresByType application/font-woff  "access plus 1 year"
  # CSS & JS — 1 month (may change more often)
  ExpiresByType text/css               "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/javascript        "access plus 1 month"
  # HTML — no cache (always fresh)
  ExpiresByType text/html              "access plus 0 seconds"
</IfModule>

# Disable ETags (Expires headers are enough)
<IfModule mod_headers.c>
  Header unset ETag
</IfModule>
FileETag None

# Enable Gzip compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json image/svg+xml
</IfModule>